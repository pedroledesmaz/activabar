PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/whatsapp_restaurant_mvp
DATABASE_SSL=false
DEFAULT_COUNTRY_CODE=+34
NODE_ENV=development
APP_NAME=whatsapp-restaurant-mvp
ACTIVABAR_PORT=3001
ACTIVABAR_APP_NAME=activabar
ACTIVABAR_SESSION_COOKIE_NAME=activabar_session
ACTIVABAR_LOG_FILE=./data/logs/activabar.log

# Seguridad basica de endpoints internos
# STAFF_TOKEN es una llave maestra opcional (fallback de emergencia).
# Recomendado: crear tokens staff por bar desde /app/restaurants/:slug
STAFF_TOKEN=dev-staff-token
JOB_TOKEN=dev-job-token
SESSION_COOKIE_NAME=wm_session
SESSION_TTL_DAYS=30

# Admin inicial del panel web (/login)
# Si no se define en local, se crea un usuario por defecto:
# admin@local.test / admin12345
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Control de saturacion de mensajes
MESSAGE_COOLDOWN_HOURS=72
WEEKLY_MESSAGE_LIMIT=2

# Confirmacion de canje en alta (landing -> WhatsApp con codigo)
WELCOME_CONFIRMATION_ENABLED=true
WELCOME_CODE_LENGTH=6

# Scheduler automatico de promociones
SCHEDULER_ENABLED=true
SCHEDULER_POLL_SECONDS=30

# Backups logicos PostgreSQL
BACKUP_ENABLED=true
BACKUP_DIR=./data/backups
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=14

# Exportacion CSV de la base PostgreSQL activa
POSTGRES_EXPORT_DIR=./exports

# Logging y alertas
LOG_FILE=./data/logs/app.log
ALERT_WEBHOOK_URL=
ALERT_MIN_LEVEL=error

# Cumplimiento legal
CONSENT_VERSION=2026-02-14-v1
PRIVACY_URL=/privacy
DATA_CONTROLLER_NAME=
DATA_CONTROLLER_EMAIL=
DATA_CONTROLLER_ADDRESS=

# Seguridad webhook Twilio (recomendado true en produccion con dominio fijo)
TWILIO_WEBHOOK_VALIDATE_SIGNATURE=false

# Proveedor WhatsApp: mock o twilio
WHATSAPP_PROVIDER=mock

# Solo si usas Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=+14155238886
